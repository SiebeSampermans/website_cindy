# Postgres. Op Vercel: Storage > Neon koppelen, dan wordt DATABASE_URL automatisch ingevuld.
DATABASE_URL=postgres://user:password@localhost:5432/tsnuffeltje

# Nodig om het eerste admin-account aan te maken via /admin/login (kies een lange, geheime code).
ADMIN_SETUP_CODE=

CONTACT_TO_EMAIL=tsnuffeltje@gmail.com
CONTACT_FROM_EMAIL=website@tsnuffeltje.be
CONTACT_FROM_NAME=t Snuffeltje Website

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

APP_URL=http://localhost:3000
SESSION_SECRET=replace-me-with-a-long-random-string

# Map voor geüploade afbeeldingen (standaard ./uploads). Moet blijven bestaan tussen deploys.
UPLOAD_DIR=

# Op Vercel: wordt automatisch ingevuld als je een Blob store koppelt. Dan komen uploads daar.
BLOB_READ_WRITE_TOKEN=
